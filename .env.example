# ============================================================
# LexGuard Environment Configuration (Root)
# ============================================================

# --- LLM Model Selection ---
# Locally: gemma2:2b (fast, low VRAM)
# Server test: llama3.1:8b (primary) or gemma3:4b (fallback)
LLM_MODEL=gemma2:2b

# --- Ollama Connection ---
# Docker internal: http://ollama:11434
# External access: http://localhost:11434
OLLAMA_URL=http://ollama:11434

# --- LLM Performance Tuning ---
# Parallel LLM workers (must match Ollama's OLLAMA_NUM_PARALLEL)
LLM_MAX_WORKERS=2
LLM_REQUEST_TIMEOUT=300
LLM_HEARTBEAT_TIMEOUT=600

# --- RAG Configuration ---
MIN_RELEVANCE_SCORE=0.50
MAX_CHUNKS_PER_SEGMENT=3

# --- Document Processing ---
ANALYSIS_BATCH_SIZE=20
MAX_SEGMENTS_PER_DOCUMENT=500

# --- Database & Infrastructure ---
# Password for Postgres (used in docker-compose.yml)
POSTGRES_PASSWORD=lexguard_dev

# Connection strings
DATABASE_URL=postgresql://lexguard:${POSTGRES_PASSWORD}@lexguard_postgres:5432/lexguard
REDIS_URL=redis://lexguard_redis:6379/0
CELERY_BROKER_URL=redis://lexguard_redis:6379/0
CELERY_RESULT_BACKEND=redis://lexguard_redis:6379/0
