# ============================================================
# LexGuard Environment Configuration
# ============================================================

# --- LLM Model Selection ---
# Locally: gemma2:2b (fast, low VRAM)
# Server test: llama3.1:8b (primary) or gemma3:4b (fallback)
LLM_MODEL=gemma2:2b

# --- Ollama Connection ---
# Docker internal: http://ollama:11434
# External access: http://localhost:11434
OLLAMA_URL=http://ollama:11434

# --- LLM Performance Tuning ---
# Parallel LLM workers (must match Ollama's OLLAMA_NUM_PARALLEL)
# 2 for 8GB VRAM, 3 for 16GB, 4-5 for 24GB+
LLM_MAX_WORKERS=2

# Request timeout in seconds (increase for larger models like llama3.1:8b)
# llama3.1:8b cold start can take 60-120s, inference 30-60s per segment
LLM_REQUEST_TIMEOUT=300

# Heartbeat timeout (analysis marked failed if no heartbeat for this duration)
LLM_HEARTBEAT_TIMEOUT=600

# --- RAG Configuration ---
# Minimum cosine similarity threshold for RAG chunks (0.0-1.0)
# Lower = more recall (may add noise), Higher = more precision (may miss norms)
# Recommended: 0.50 for recall, 0.70 for precision
MIN_RELEVANCE_SCORE=0.50

# Max RAG chunks per segment (more = more context but slower)
MAX_CHUNKS_PER_SEGMENT=3

# --- Document Processing ---
# Number of segments per processing batch (streaming to frontend)
ANALYSIS_BATCH_SIZE=20

# Max segments accepted per document (0 = unlimited)
MAX_SEGMENTS_PER_DOCUMENT=500

# --- Database ---
DATABASE_URL=postgresql://lexguard:lexguard_dev@postgres:5432/lexguard
REDIS_URL=redis://lexguard_redis:6379/0
