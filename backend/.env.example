LLM_MODEL=gemma3:4b # locally
# LLM_MODEL=gemma3:latest # on the server

# Parallel LLM workers (must match Ollama's OLLAMA_NUM_PARALLEL)
# 2 for 8GB VRAM, 3 for 16GB, 4-5 for 24GB+
LLM_MAX_WORKERS=2

# Number of segments per processing batch.
# Each batch is saved to DB immediately, enabling streaming to frontend.
ANALYSIS_BATCH_SIZE=20

# Max segments accepted per document (0 = unlimited).
MAX_SEGMENTS_PER_DOCUMENT=500

DATABASE_URL=postgresql://lexguard:lexguard_dev@postgres:5432/lexguard
